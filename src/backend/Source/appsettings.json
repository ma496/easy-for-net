{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RoutePrefix": "api",
  "FeatureManagement": {
  },
  "Auth": {
    "Jwt": {
      "Key": "a long secret string used to sign jwts. usually set via matching environment variable.",
      "Issuer": "the issuer of the jwt",
      "Audience": "the audience of the jwt"
    },
    "AccessTokenValidity": "60",
    "RefreshTokenValidity": "168"
  },
  "Redis": {
    "InstanceName": "EasyForNet:"
  },
  "Payload": {
    "MaximumSize": "26214400"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=EasyForNet;Username=postgres;Password={password}",
    "Redis": "localhost:6379,password=redis"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "your-email@gmail.com",
    "SmtpPassword": "your-app-password",
    "SenderEmail": "your-email@gmail.com",
    "SenderName": "Sender Name"
  },
  "Hangfire": {
    "Storage": {
      "ConnectionString": "Host=localhost;Port=5432;Database=EasyForNet;Username=postgres;Password={password}"
    }
  },
  "Web": {
    "DefaultDomain": "http://localhost:3000",
    "Domains": ["http://localhost:3000"]
  },
  "Notifications": {
    "RetentionDays": 90,
    "MaxConnectionsPerUser": 20
  }
}