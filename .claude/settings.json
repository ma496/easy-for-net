{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(npm run gate)",
      "Bash(npm run gate -- *)",
      "Bash(npm run verify)",
      "Bash(npm run verify -- *)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm test -- *)",
      "Bash(npm run test:hooks)",
      "Bash(npm run stop:api)",
      "Bash(npm run auto:status)",
      "Bash(npm run auto:status -- *)",
      "Bash(npm run queue)",
      "Bash(npm run queue -- list*)",
      "Bash(npm run queue -- add*)",
      "Bash(npm run lessons)",
      "Bash(npm run owes)",
      "Bash(npm run owes -- --base *)",
      "Bash(node --check *)",
      "Bash(node .claude/hooks/hook-tests.mjs)",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx vitest run*)",
      "Bash(npm run lint)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a*)",
      "Bash(git branch -v*)",
      "Bash(git branch --list*)",
      "Bash(git rev-parse*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(npm run gate)",
      "PowerShell(npm run gate -- *)",
      "PowerShell(npm run verify)",
      "PowerShell(npm run verify -- *)",
      "PowerShell(npm test)",
      "PowerShell(dotnet build*)",
      "PowerShell(dotnet test*)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(wc *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npm run queue -- drain*)",
      "Bash(npm run auto -- *)",
      "Bash(npm run loop*)",
      "Bash(npm run schedule*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/appsettings.Development.json)",
      "Read(**/appsettings.Testing.json)",
      "Read(**/appsettings.Production.json)",
      "Read(**/appsettings.Staging.json)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(grep * .env)",
      "Bash(head .env)",
      "Bash(tail .env)",
      "Bash(cp .env *)",
      "Bash(npm run deploy:vps*)",
      "Bash(node scripts/deploy-vps.mjs*)",
      "Bash(rm -rf /*)",
      "mcp__redis__set",
      "mcp__redis__delete",
      "mcp__redis__expire",
      "mcp__redis__rename",
      "mcp__redis__hset",
      "mcp__redis__hdel",
      "mcp__redis__set_vector_in_hash",
      "mcp__redis__json_set",
      "mcp__redis__json_del",
      "mcp__redis__lpush",
      "mcp__redis__rpush",
      "mcp__redis__lpop",
      "mcp__redis__rpop",
      "mcp__redis__lrem",
      "mcp__redis__sadd",
      "mcp__redis__srem",
      "mcp__redis__zadd",
      "mcp__redis__zrem",
      "mcp__redis__xadd",
      "mcp__redis__xdel",
      "mcp__redis__xack",
      "mcp__redis__xgroup_create",
      "mcp__redis__xgroup_destroy",
      "mcp__redis__xreadgroup",
      "mcp__redis__publish",
      "mcp__redis__create_vector_index_hash"
    ]
  },
  "enabledMcpjsonServers": ["postgres", "redis", "playwright"],
  "statusLine": {
    "type": "command",
    "command": "node $CLAUDE_PROJECT_DIR/.claude/statusline.mjs"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected-paths.mjs"
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/guard-secret-reads.mjs"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/project-conventions.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs"
          }
        ]
      }
    ]
  }
}
