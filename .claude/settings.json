{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(pnpm gate)",
      "Bash(pnpm gate *)",
      "Bash(pnpm verify)",
      "Bash(pnpm verify *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:hooks)",
      "Bash(pnpm stop:api)",
      "Bash(pnpm auto:status)",
      "Bash(pnpm auto:status *)",
      "Bash(pnpm queue)",
      "Bash(pnpm queue list*)",
      "Bash(pnpm queue add*)",
      "Bash(pnpm lessons)",
      "Bash(pnpm owes)",
      "Bash(pnpm owes --base *)",
      "Bash(node --check *)",
      "Bash(node .claude/hooks/hook-tests.mjs)",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(pnpm exec tsc --noEmit*)",
      "Bash(pnpm exec vitest run*)",
      "Bash(pnpm lint)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a*)",
      "Bash(git branch -v*)",
      "Bash(git branch --list*)",
      "Bash(git rev-parse*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(pnpm gate)",
      "PowerShell(pnpm gate *)",
      "PowerShell(pnpm verify)",
      "PowerShell(pnpm verify *)",
      "PowerShell(pnpm test)",
      "PowerShell(pnpm test *)",
      "PowerShell(dotnet build*)",
      "PowerShell(dotnet test*)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(wc *)",
      "Bash(pnpm stack up)",
      "Bash(pnpm stack status)",
      "Bash(pnpm stack down)",
      "PowerShell(pnpm stack up)",
      "PowerShell(pnpm stack status)",
      "PowerShell(pnpm stack down)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_navigate_back",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_select_option",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_emulate_media",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_close"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(pnpm queue drain*)",
      "Bash(pnpm auto *)",
      "Bash(pnpm loop*)",
      "Bash(pnpm schedule*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/appsettings.Development.json)",
      "Read(**/appsettings.Testing.json)",
      "Read(**/appsettings.Production.json)",
      "Read(**/appsettings.Staging.json)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(grep * .env)",
      "Bash(head .env)",
      "Bash(tail .env)",
      "Bash(cp .env *)",
      "Bash(pnpm deploy:vps*)",
      "Bash(pnpm run deploy:vps*)",
      "Bash(node scripts/deploy-vps.mjs*)",
      "Bash(rm -rf /*)",
      "mcp__redis__set",
      "mcp__redis__delete",
      "mcp__redis__expire",
      "mcp__redis__rename",
      "mcp__redis__hset",
      "mcp__redis__hdel",
      "mcp__redis__set_vector_in_hash",
      "mcp__redis__json_set",
      "mcp__redis__json_del",
      "mcp__redis__lpush",
      "mcp__redis__rpush",
      "mcp__redis__lpop",
      "mcp__redis__rpop",
      "mcp__redis__lrem",
      "mcp__redis__sadd",
      "mcp__redis__srem",
      "mcp__redis__zadd",
      "mcp__redis__zrem",
      "mcp__redis__xadd",
      "mcp__redis__xdel",
      "mcp__redis__xack",
      "mcp__redis__xgroup_create",
      "mcp__redis__xgroup_destroy",
      "mcp__redis__xreadgroup",
      "mcp__redis__publish",
      "mcp__redis__create_vector_index_hash"
    ]
  },
  "enabledMcpjsonServers": [
    "postgres",
    "redis",
    "playwright"
  ],
  "statusLine": {
    "type": "command",
    "command": "node $CLAUDE_PROJECT_DIR/.claude/statusline.mjs"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected-paths.mjs"
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/guard-secret-reads.mjs"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/stop-api-on-backend-edit.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/project-conventions.mjs"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/stop-api-on-backend-edit.mjs"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/stop-api-on-backend-edit.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs"
          }
        ]
      }
    ]
  }
}