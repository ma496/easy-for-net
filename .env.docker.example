# Production values for docker-compose.prod.yml. Copy to .env (git-ignored) and fill in every value:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# Prefix for the production stack's containers and volumes. Do not set COMPOSE_PROJECT_NAME here:
# Compose reads this file for the development docker-compose.yml too, and would merge the two stacks.
PROD_PROJECT_NAME=app

# The public host name Caddy obtains a certificate for, and the URL the browser uses.
# For a local trial use DOMAIN=localhost and PUBLIC_URL=https://localhost (Caddy's own CA).
DOMAIN=example.com
PUBLIC_URL=https://example.com

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me
REDIS_INSTANCE_NAME=app:

# Signs access tokens: a random string of AT LEAST 32 characters, or the API refuses to start.
# Generate one with `openssl rand -base64 48`
JWT_KEY=

# Password of the seeded administrators (admin and tenantadmin), 8 to 50 characters. Used only when
# the accounts are first created: change it here before the first start, and in the app afterwards.
SEED_ADMIN_PASSWORD=

# Default outgoing mail settings (administrators can override them at run time)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=

# Development only: the host ports docker-compose.yml publishes PostgreSQL and Redis on. Change them when
# another server already holds the port, and change the Port in ConnectionStrings:DefaultConnection and
# Hangfire:Storage:ConnectionString, and the port in ConnectionStrings:Redis, of appsettings.Development.json
# and appsettings.Testing.json to match. The production stacks ignore them.
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379
